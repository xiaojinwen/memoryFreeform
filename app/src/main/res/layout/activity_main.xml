<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/btn_shizuku_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_shizuku" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/enable_mode"
            android:textSize="16sp" />
        <Switch
            android:id="@+id/switch_enable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/select_corner"
        android:textSize="16sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_corner_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/corner_left" />
        <Button
            android:id="@+id/btn_corner_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/corner_right" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="小窗显示尺寸（宽高独立，最大为屏幕 80%）"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/edit_display_width"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="宽度"
            android:inputType="number"
            android:text="540" />
        <EditText
            android:id="@+id/edit_display_height"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="高度"
            android:inputType="number"
            android:text="1200" />
        <Button
            android:id="@+id/btn_apply_display_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="应用" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/scale_ratio"
        android:textSize="16sp" />
    <SeekBar
        android:id="@+id/slider_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="140"
        android:progress="60" />
    <TextView
        android:id="@+id/tv_scale_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="120%"
        android:textSize="14sp" />

    <!-- 显示尺寸输入控件已在上方统一定义 -->

</LinearLayout>